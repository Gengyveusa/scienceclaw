# ScienceClaw Environment Configuration
# Copy this file to .env and fill in your actual values.

# ── LLM API Keys ─────────────────────────────────────────────────────────────
# At least one LLM key is required for autonomous agent operation.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── NCBI E-utilities ─────────────────────────────────────────────────────────
# Get your API key from: https://www.ncbi.nlm.nih.gov/account/settings/
# With API key: 10 requests/sec. Without: 3 requests/sec.
NCBI_API_KEY=
NCBI_EMAIL=

# ── Optional: OpenRouter (for Perplexity search skill) ───────────────────────
# OPENROUTER_API_KEY=sk-or-v1-...
