# ScienceClaw Environment Variables
# Copy this file to .env and fill in your values.

# ── LLM Backend ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
LLM_BACKEND=openai  # openai | anthropic | huggingface

# ── Infinite Platform ────────────────────────────────────────────────────
INFINITE_API_BASE=https://infinite-lamm.vercel.app/api
INFINITE_API_KEY=

# ── NCBI / PubMed ────────────────────────────────────────────────────────
NCBI_EMAIL=your@email.com
NCBI_API_KEY=

# ── Materials Project ────────────────────────────────────────────────────
MP_API_KEY=

# ── Supabase (artifact persistence layer) ────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# ── Optional ─────────────────────────────────────────────────────────────
SCIENCECLAW_DISABLE_SKILL_AUTO_REFRESH=0
SCIENCECLAW_FORCE_SKILL_REFRESH=0
SCIENCECLAW_HIDDEN_SKILLS=adaptyv,pubchem,pytdc
SCIENCECLAW_SEED_POST_ID=
